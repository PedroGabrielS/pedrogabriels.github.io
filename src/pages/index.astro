---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProjectDetails from '@/components/ProjectDetails.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import { profile, projects } from '@/data/profile';
---

<Base>
  <Nav />
  <Hero />

  <section id="sobre" class="border-b border-line py-16 md:py-24">
    <div class="grid gap-6 md:grid-cols-[.75fr_1.25fr] md:gap-[70px]">
      <div class="label">01 — Sobre</div>
      <p class="max-w-[700px] text-[clamp(22px,2.5vw,32px)] leading-[1.35] tracking-[-0.04em]">
        {profile.about}
      </p>
    </div>
  </section>

  <section id="projetos" class="border-b border-line py-16 md:py-24">
    <SectionHead title="Projetos recentes" label="02 — Projetos" />
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <ProjectDetails />
  <Experience />
  <Skills />
  <Contact />
  <Footer />
</Base>
