---
/**
 * Layout raiz: <head>, fontes, metadados e container principal.
 */
import '@/styles/global.css';
import { profile } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — Software Engineer`,
  description = profile.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// BASE_URL pode vir com ou sem barra final dependendo da config; normaliza.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${basePath}/favicon.svg`;
// Imagem de pré-visualização (gerada por `npm run og`); precisa de URL absoluta.
const ogImage = new URL(`${basePath}/og.png`, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a1017" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto max-w-[1160px] px-5 md:px-8">
      <slot />
    </main>
  </body>
</html>
