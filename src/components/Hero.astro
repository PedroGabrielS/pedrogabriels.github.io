---
import { profile } from '@/data/profile';
import Button from './Button.astro';
---

<section
  id="top"
  class="grid grid-cols-1 items-end gap-10 border-b border-line py-16 md:min-h-[575px] md:grid-cols-[1.15fr_.85fr] md:gap-16 md:py-[72px]"
>
  <div>
    <div class="label mb-6">{profile.headline}</div>
    {/* Mantido em uma linha: o compilador do Astro remove quebras de linha entre expressões. */}
    <h1 class="max-w-[770px] text-[clamp(44px,6.1vw,76px)] leading-[1.03] font-extrabold tracking-[-0.05em]">
      {profile.hero.titleStart} <span class="text-green">{profile.hero.titleAccent}</span> {profile.hero.titleEnd}
    </h1>
  </div>
  <div class="max-w-[440px] self-end text-base leading-[1.75] text-ink/90 md:mb-2">
    <p>Sou {profile.name}. {profile.hero.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#projetos">Ver projetos</Button>
      <Button href="#contato" variant="outline">Vamos conversar</Button>
    </div>
  </div>
</section>
