---
import { profile } from '@/data/profile';
import Button from './Button.astro';
---

<section
  id="top"
  class="grid grid-cols-1 items-end gap-10 border-b border-line py-16 md:min-h-[575px] md:grid-cols-[1.35fr_.65fr] md:py-[72px]"
>
  <div>
    <div class="label mb-6">{profile.headline}</div>
    <h1 class="max-w-[770px] text-[clamp(44px,6.1vw,76px)] leading-[1.01] font-extrabold tracking-[-0.07em]">
      {profile.hero.titleStart}
      <span class="text-green">{profile.hero.titleAccent}</span>
      {profile.hero.titleEnd}
    </h1>
  </div>
  <div class="max-w-[370px] self-center text-base leading-relaxed md:mt-[90px] md:ml-auto">
    <p>Sou {profile.name}. {profile.hero.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#projetos">Ver projetos</Button>
      <Button href="#contato" variant="outline">Vamos conversar</Button>
    </div>
  </div>
</section>
