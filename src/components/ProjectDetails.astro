---
/**
 * Seção "Em detalhe": uma entrada por projeto com destaques e stack completa.
 * Cada entrada tem id = `projeto-<slug>`, usado como âncora pelos cards.
 */
import { projects } from '@/data/profile';
import SectionHead from './SectionHead.astro';
---

<section id="detalhes" class="border-b border-line py-16 md:py-24">
  <SectionHead title="Projetos em detalhe" label="03 — Em detalhe" />
  <div class="divide-y divide-line border-y border-line">
    {
      projects.map((p, i) => (
        <article id={`projeto-${p.slug}`} class="grid scroll-mt-24 gap-6 py-10 md:grid-cols-[.35fr_.65fr] md:gap-10">
          <div>
            <span class="label">
              {String(i + 1).padStart(2, '0')} · {p.context}
            </span>
            <h3 class="mt-2 text-2xl font-extrabold tracking-[-0.05em]">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.description}</p>
          </div>
          <div>
            <ul class="space-y-3 text-sm leading-relaxed">
              {p.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <span class="label">Stack</span>
              <ul class="mt-2 flex flex-wrap gap-2">
                {p.stack.map((s) => (
                  <li class="rounded-full border border-line bg-white px-2 py-1 font-mono text-[10px] font-medium text-ink">
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
