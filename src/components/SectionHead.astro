---
interface Props {
  title: string;
  label: string;
}
const { title, label } = Astro.props;
---

<div class="mb-10 flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
  <h2 class="text-[clamp(28px,4vw,44px)] font-extrabold tracking-[-0.06em]">{title}</h2>
  <span class="label">{label}</span>
</div>
